{
  "name": "alhabeed-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm --prefix client run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "dev": "tsx src/server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "start": "node dist/src/server/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.6.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
