{
  "name": "alhabeed-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:all": "npm run build && npm --prefix client run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm test && npm run assets:verify && npm --prefix client run build",
    "assets:verify": "tsx scripts/verifyAssetManifest.ts",
    "migrate": "npm run build && node dist/src/persistence/migrate.js",
    "content:seed:generate": "tsx scripts/generateQuestionSeed.ts",
    "content:seed:load": "tsx scripts/loadQuestionSeed.ts",
    "db:verify": "tsx scripts/verifyDatabase.ts",
    "smoke:multiplayer": "tsx scripts/smokeMultiplayer.ts",
    "db:cleanup:test-rooms": "tsx scripts/cleanupTestRooms.ts",
    "db:rooms:audit": "tsx scripts/auditRooms.ts",
    "dev": "tsx src/server/index.ts",
    "dev:client": "npm --prefix client run dev",
    "start": "node dist/src/server/index.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "fastify": "^5.6.1",
    "postgres": "^3.4.9",
    "redis": "^6.2.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
